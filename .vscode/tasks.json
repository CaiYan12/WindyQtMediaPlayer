{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. CMake Configure",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "D:\\Dev\\MediaPlayer\\scripts\\build-ps.ps1", "config"],
      "problemMatcher": ["$cmake"],
      "group": { "kind": "build", "isDefault": false },
      "detail": "配置 CMake（首次运行或 CMakeLists.txt 变更后）"
    },
    {
      "label": "2. Build Debug",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "D:\\Dev\\MediaPlayer\\scripts\\build-ps.ps1"],
      "problemMatcher": ["$msCompile"],
      "group": { "kind": "build", "isDefault": true },
      "detail": "编译 Debug 版本（Ctrl+Shift+B）"
    },
    {
      "label": "3. Build Release",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "D:\\Dev\\MediaPlayer\\scripts\\build-ps.ps1", "release"],
      "problemMatcher": ["$msCompile"],
      "group": { "kind": "build", "isDefault": false },
      "detail": "编译 Release 优化版本"
    },
    {
      "label": "4. Clean Build",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "D:\\Dev\\MediaPlayer\\scripts\\build-ps.ps1", "clean"],
      "problemMatcher": [],
      "detail": "删除 build 目录（清理缓存）"
    },
    {
      "label": "5. Full Build (Clean + Configure + Debug)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "D:\\Dev\\MediaPlayer\\scripts\\build-ps.ps1", "full"],
      "problemMatcher": ["$msCompile", "$cmake"],
      "detail": "清理 + 配置 + 编译（最保险的重构建）"
    },
    {
      "label": "6. Run",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "D:\\Dev\\MediaPlayer\\scripts\\build-ps.ps1", "run"],
      "problemMatcher": [],
      "detail": "运行编译好的 MediaPlayer.exe"
    }
  ]
}
