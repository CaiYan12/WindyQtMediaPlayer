    "C:/Qt/6.10.0/msvc2022_64/include/QtCore",
    "C:/Qt/6.10.0/msvc2022_64/include/QtGui",
    "C:/Qt/6.10.0/msvc2022_64/include/QtWidgets",
    "C:/Qt/6.10.0/msvc2022_64/include/QtMultimedia",
    "C:/Qt/6.10.0/msvc2022_64/include/QtMultimediaWidgets",
    "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/include",
    "C:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/ucrt",
    "C:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/shared",
    "C:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/winrt"
