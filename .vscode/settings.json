  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c11",

  // ========== CMake Tools ==========
  "cmake.configureOnOpen": true,
  "cmake.configureSettings": {
    "CMAKE_PREFIX_PATH": "C:/Qt/6.10.0/msvc2022_64/lib/cmake",
    "CMAKE_MKTEST": "OFF",
    "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
  },

  // ========== 文件排除（不索引 build 目录）==========
  "files.exclude": {
    "**/build/**": true,
    "**/.cmake/**": true,
    "**/CMakeFiles/**": true,
    "**/.vs/**": true
  },

  // ========== 格式化 ==========
  "C_Cpp.default.formatting": "Visual Studio",

  // ========== 编码 ==========
  "files.encoding": "utf8",
  "files.associations": {
    "*.h": "cpp",
    "*.cpp": "cpp",
    "*.ui": "xml"
  },

  // ========== Qt Designer ==========
  "qtcreator.qt-designer.formlayout": "grid",

  // ========== 终端 ==========
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontSize": 13
}
