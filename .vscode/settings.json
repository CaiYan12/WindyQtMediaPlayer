{
  // ========== Qt / C++ IntelliSense ==========
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.compilerPath": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.43.34808/bin/HostX64/x64/cl.exe",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
